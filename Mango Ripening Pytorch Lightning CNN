pload or provide correct path.\")\n","\n","# Class names\n","class_names = sorted(entry.name for entry in os.scandir(data_dir) if entry.is_dir())\n","num_classes = len(class_names)\n","\n","print(f\"Classes found: {class_names}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0w_FzuZZ5t1u","executionInfo":{"status":"ok","timestamp":1745873831274,"user_tz":-330,"elapsed":21,"user":{"displayName":"N190249 KADIYAM JYOTHSNA","userId":"13797471817610616598"}},"outputId":"ecfe9add-942b-4d8f-f6fd-aee0ea7b1922"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Classes found: ['OverRipe', 'Ripe', 'UnRipe']\n"]}]},{"cell_type":"code","source":["# Transformations\n","transform = transforms.Compose([\n","    transforms.Resize((224, 224)),  # MobileNet expects 224x224\n","    transforms.RandomRotation(10),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406],  # Standard ImageNet normalization\n","                         [0.229, 0.224, 0.225])\n","])\n","\n","# Lightning DataModule\n","class MangoDataModule(pl.LightningDataModule):\n","    def __init__(self, batch_size=32):\n","        super().__init__()\n","        self.batch_size = batch_size\n","\n","    def setup(self, stage=None):\n","        dataset = datasets.ImageFolder(root=data_dir, transform=transform)\n","        train_size = int(0.6 * len(dataset))\n","        val_size = int(0.2 * len(dataset))\n","        test_size = len(dataset) - train_size - val_size\n","        self.train_set, self.val_set, self.test_set = random_split(dataset, [train_size, val_size, test_size])\n","\n","    def train_dataloader(self):\n","        return DataLoader(self.train_set, batch_size=self.batch_size, shuffle=True, num_workers=4)\n","\n","    def val_dataloader(self):\n","        return DataLoader(self.val_set, batch_size=self.batch_size, shuffle=False, num_workers=4)\n","\n","    def test_dataloader(self):\n","        return DataLoader(self.test_set, batch_size=self.batch_size, shuffle=False, num_workers=4)\n"],"metadata":{"id":"4-IBvN1x6Hnb"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["class MobileNetClassifier(pl.LightningModule):\n","    def __init__(self):\n","        super().__init__()\n","        # Load pretrained MobileNetV2\n","        self.model = models.mobilenet_v2(pretrained=True)\n","\n","        # Replace classifier\n","        self.model.classifier[1] = nn.Linear(self.model.last_channel, num_classes)\n","\n","    def forward(self, x):\n","        return self.model(x)\n","\n","    def configure_optimizers(self):\n","        return torch.optim.Adam(self.parameters(), lr=0.0005)\n","\n","    def training_step(self, batch, batch_idx):\n","        x, y = batch\n","        y_hat = self(x)\n","        loss = F.cross_entropy(y_hat, y)\n","        acc = (y_hat.argmax(dim=1) == y).float().mean()\n","        self.log('train_loss', loss)\n","        self.log('train_acc', acc)\n","        return loss\n","\n","    def validation_step(self, batch, batch_idx):\n","        x, y = batch\n","        y_hat = self(x)\n","        loss = F.cross_entropy(y_hat, y)\n","        acc = (y_hat.argmax(dim=1) == y).float().mean()\n","        self.log('val_loss', loss, prog_bar=True)\n","        self.log('val_acc', acc, prog_bar=True)\n","        return loss\n","\n","    def test_step(self, batch, batch_idx):\n","        x, y = batch\n","        y_hat = self(x)\n","        loss = F.cross_entropy(y_hat, y)\n","        acc = (y_hat.argmax(dim=1) == y).float().mean()\n","        self.log('test_loss', loss, prog_bar=True)\n","        self.log('test_acc', acc, prog_bar=True)\n","        return loss\n"],"metadata":{"id":"tPCnRSpP6KpU"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Instantiate datamodule and model\n","datamodule = MangoDataModule()\n","model = MobileNetClassifier()\n","\n","# Setup Trainer\n","trainer = pl.Trainer(\n","    max_epochs=10,\n","    accelerator=\"gpu\" if torch.cuda.is_available() else \"cpu\",\n",")\n","\n","# Fit the model\n","trainer.fit(model, datamodule)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":625,"referenced_widgets":["631e05c400f844c7985e2617b0b77cec","1c46ddbddcb94b31b6bc61eb3b13d4a7","54c1c39537bd4f54bda11123de15d078","32e62185d9414029bfe769e99b02e79d","31b89a75d2bf446596514a90ed8afaa6","b5e15740d329499a98ea6d73c15f0b28","96f19f0e6d7e49f2904b0eb9f8859b73","354572f2530745e5b5fa387085e23f75","96ff0fd87f0d471586e72ef420eb7d6a","1f52d7a648854fdb881639e0a48c13be","076f03d267bc49cea84972370870051c","6b42bf12c78c4ac88541772cb571f83c","bcca2e206c5e4ef7a0351c283ba8a59a","2206c5ff1923485488c80db5e8ab510a","a08ee7c93abc4cd2869497101abc9e44","216950f1652b425a8e872fbf6fa466b5","18b97bcea302471f985b172bbed37cec","f1fbedee12ef421ba8af3cbf81771163","2cb9f4eb27c343cd912b9bc2a28a7a77","46128a31db4f46839a331534fbb301db","b276be7d2cd84d8295a8ea4cd0c33754","7f91bddaa42c45d08cdececbd4e8577e","d60e840ace414f259af3f5ac04631e34","c0e199c2831146ba8ec1e6f9f6808f16","081bd569bdfe48bf9c773481be9b6e6d","e7f2ca5b279946e98a92f5a677bc464f","9111161b58bf4120b37cbacc13972fce","49b51c67bf15465ba5197282d79e33c3","147cb15d81b1433eb962716b23b8cec3","b1d9822751d64113adf98fae0786352c","b62d31e7960f4ba68035e3c619bea43e","74a9a1ec9b144b77b9fd31271706da9a","9238c21060174a91a90d7622994f467c","8b26618632c54a6bbc796126473f6695","e67c01ae4f974996b6e5940f7e8e0847","737f81d5754e430fb712a1567fc4e141","7ec98342e94444e692edded3787761f9","c827edd4058c4c488441601e55af5e00","6a820b47e8da4102bbddd46a3cd89a3b","2943d68f3e2d4e35802f8a1b83f2f436","732b3275534946f28fbf58f273d5057c","b0a9d6855e25448393cbd82b054bacde","9b0cfb49718b409fa8f69768412f95aa","1c0346d11ecd4601a60938f24a968e18","a7c7abcf8ab54110874767a683650735","b54b595b494a493a8e8f07a943db4e52","6a98596cdc274fdda6429516806af7c5","8ba70a5afbb5480b87db38b0ebb0051c","36ddb4bfd9334c129bfdb1a69fd2a16c","b3c15450ed5540d2a2c23faaed8ad167","2135ac